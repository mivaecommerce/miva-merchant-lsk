<MvFUNCTION NAME = "Module_Description" PARAMETERS = "module var" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.module:code"		VALUE = "mmlsk-discount_basket_product">
	<MvASSIGN NAME = "l.module:name"		VALUE = "Basket Discount (Specific Products)">
	<MvASSIGN NAME = "l.module:provider"	VALUE = "Miva Merchant">
	<MvASSIGN NAME = "l.module:version"		VALUE = "26.0300">
	<MvASSIGN NAME = "l.module:api_ver"		VALUE = "26.03">
	<MvASSIGN NAME = "l.module:features"	VALUE = "discount">
</MvFUNCTION>

<MvCOMMENT>
|
| Discounting Subsystem Feature (discount)
|
</MvCOMMENT>

<MvFUNCTION NAME = "DiscountModule_Capabilities" PARAMETERS = "module var, capabilities var" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.capabilities"						VALUE = "">
	<MvASSIGN NAME = "l.capabilities:items"					VALUE = 0>
	<MvASSIGN NAME = "l.capabilities:eligibility"			VALUE = "builtin">
	<MvASSIGN NAME = "l.capabilities:basket"				VALUE = 1>
	<MvASSIGN NAME = "l.capabilities:shipping"				VALUE = 0>
	<MvASSIGN NAME = "l.capabilities:tax"					VALUE = 0>
	<MvASSIGN NAME = "l.capabilities:provision_settings"	VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Property_Template" PARAMETERS = "module var" STANDARDOUTPUTLEVEL = "text, html, compresswhitespace">
	<mm-flex-group>
		<mm-flex-item prompt="Discount">
			<mm-grid columns="3" column-sizes="repeat(3, 1fr)" grow="1">
				<mm-grid-column grid-column="span 2">
					<mm-module-field-ui code="type" size="full"></mm-module-field-ui>
				</mm-grid-column>

				<mm-grid-column>
					<mm-module-field-ui code="discount" size="full"></mm-module-field-ui>
				</mm-grid-column>
			</mm-grid>
		</mm-flex-item>

		<mm-flex-item prompt="Maximum Discount Amount">
			<mm-flex-group>
				<mm-module-field-ui code="maxdiscounttype" size="full"></mm-module-field-ui>
				<mm-module-field-ui code="maxdiscount" size="full"></mm-module-field-ui>
			</mm-flex-group>
		</mm-flex-item>
	</mm-flex-group>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Properties" PARAMETERS = "module var" STANDARDOUTPUTLEVEL = "text, html, compresswhitespace">
	{
		"discount":
		{
			"type": "text",
			"required": true,
			"text_type": "number",
			"min": 0,
			"pad_right_digits": 2
		},
		"type":
		{
			"type": "selector",
			"required": true,
			"options":
			[
				{
					"text": "Fixed",
					"value": "fixed"
				},
				{
					"text": "Percent",
					"value": "percent"
				}
			]
		},
		"maxdiscounttype":
		{
			"type": "select",
			"options":
			[
				{
					"text": "Set Amount",
					"value": "custom"
				},
				{
					"text": "No Restrictions",
					"value": "none"
				}
			]
		},
		"maxdiscount":
		{
			"type": "text",
			"required": true,
			"text_type": "number",
			"min": 0,
			"pad_right_digits": 2,
			"visibility_conditions":
			{
				"maxdiscounttype":
				{
					"value": [ "custom" ]
				}
			}
		}
	}
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Settings_Default" PARAMETERS = "module var, settings var" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.settings"							VALUE = "">
	<MvASSIGN NAME = "l.settings:discount:value"			VALUE = 0.00>
	<MvASSIGN NAME = "l.settings:type:value"				VALUE = "fixed">
	<MvASSIGN NAME = "l.settings:maxdiscount:value"			VALUE = 0.00>
	<MvASSIGN NAME = "l.settings:maxdiscounttype:value"		VALUE = "none">

	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Settings_Load" PARAMETERS = "module var, pricegroup var, settings var" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.settings"								VALUE = "">
	<MvASSIGN NAME = "l.settings:discount:value"				VALUE = "{ l.pricegroup:config:discount ROUND 2 }">
	<MvASSIGN NAME = "l.settings:type:value"					VALUE = "{ l.pricegroup:config:type }">

	<MvIF EXPR = "{ l.pricegroup:config:maxdiscount EQ 0 }">
		<MvASSIGN NAME = "l.settings:maxdiscount:value"			VALUE = 0.00>
		<MvASSIGN NAME = "l.settings:maxdiscounttype:value"		VALUE = "none">
	<MvELSE>
		<MvASSIGN NAME = "l.settings:maxdiscount:value"			VALUE = "{ l.pricegroup:config:maxdiscount ROUND 2 }">
		<MvASSIGN NAME = "l.settings:maxdiscounttype:value"		VALUE = "custom">
	</MvIF>

	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Settings_Validate" PARAMETERS = "module var, pricegroup var, settings var" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Settings_Update" PARAMETERS = "module var, pricegroup var, settings var" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.pricegroup:config:discount"		VALUE = "{ l.settings:discount:value }">
	<MvASSIGN NAME = "l.pricegroup:config:type"			VALUE = "{ l.settings:type:value }">

	<MvIF EXPR = "{ l.settings:maxdiscounttype:value EQ 'custom' }"> 	<MvASSIGN NAME = "l.pricegroup:config:maxdiscount" VALUE = "{ l.settings:maxdiscount:value ROUND 2 }">
	<MvELSE>															<MvASSIGN NAME = "l.pricegroup:config:maxdiscount" VALUE = 0.00>
	</MvIF>

	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Discount_Basket" PARAMETERS = "module var, pricegroup var, discount_state var" STANDARDOUTPUTLEVEL = "">
	<MvIF EXPR = "{ l.pricegroup:config:type EQ 'percent' }">	<MvASSIGN NAME = "l.discount" VALUE = "{ ( [ g.Module_Feature_PGR_UT ].DiscountState_Eligible_Total( l.discount_state ) * ( l.pricegroup:config:discount / 100.0 ) ) ROUND 2 }">
	<MvELSEIF EXPR = "{ l.pricegroup:config:type EQ 'fixed' }">	<MvASSIGN NAME = "l.discount" VALUE = "{ l.pricegroup:config:discount }">
	<MvELSE>													<MvASSIGN NAME = "l.discount" VALUE = 0.00>
	</MvIF>

	<MvIF EXPR = "{ l.pricegroup:config:maxdiscount AND ( l.discount GT l.pricegroup:config:maxdiscount ) }">
		<MvASSIGN NAME = "l.discount" VALUE = "{ l.pricegroup:config:maxdiscount }">
	</MvIF>

	<MvIF EXPR = "{ l.discount }">
		<MvEVAL EXPR = "{ [ g.Module_Feature_PGR_UT ].DiscountState_Discount_Eligible_Fixed( l.discount_state, l.discount ) }">
	</MvIF>

	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Provision_Settings" PARAMETERS = "module var, pricegroup var, provide_xml var" STANDARDOUTPUTLEVEL = "">
	<MvIF EXPR = "{ l.pricegroup:module_id NE l.module:id }">
		<MvASSIGN NAME = "l.pricegroup:config"				VALUE = "">
		<MvASSIGN NAME = "l.pricegroup:config:discount"		VALUE = 0.00>
		<MvASSIGN NAME = "l.pricegroup:config:type"			VALUE = "fixed">
		<MvASSIGN NAME = "l.pricegroup:config:maxdiscount"	VALUE = 0.00>
	</MvIF>

	<MvIF EXPR = "{ NOT [ g.Module_Feature_PRV_AD ].PRV_Tag_Number(	'o', l.provide_xml, 'Discount',		l.pricegroup:config:discount,		10, 2 )								OR
					NOT [ g.Module_Feature_PRV_AD ].PRV_Tag_List(	'o', l.provide_xml, 'Type',			l.pricegroup:config:type,			'Fixed,Percent', 'fixed,percent' )	OR
					NOT [ g.Module_Feature_PRV_AD ].PRV_Tag_Number( 'o', l.provide_xml, 'MaxDiscount',	l.pricegroup:config:maxdiscount,	10, 2 ) }">
		<MvFUNCTIONRETURN VALUE = 0>
	</MvIF>

	<MvIF EXPR = "{ NOT [ g.Module_Admin ].Validate_Currency_NonNegative_Required( l.pricegroup:config:discount ) }">
		<MvFUNCTIONRETURN VALUE = "{ [ g.Module_Feature_PRV_AD ].PRV_LogMessage( l.provide_xml, 'Discount must be a non-negative number' ) }">
	</MvIF>

	<MvIF EXPR = "{ NOT [ g.Module_Admin ].Validate_Currency_NonNegative_Required( l.pricegroup:config:maxdiscount ) }">
		<MvFUNCTIONRETURN VALUE = "{ [ g.Module_Feature_PRV_AD ].PRV_LogMessage( l.provide_xml, 'MaxDiscount must be a non-negative number' ) }">
	</MvIF>

	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_PriceGroup_Delete" PARAMETERS = "module var, pricegroup var" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_PriceGroup_Copy" PARAMETERS = "module var, source_pricegroup var, dest_pricegroup var" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>
