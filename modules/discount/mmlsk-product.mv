<MvFUNCTION NAME = "Module_Description" PARAMETERS = "module var" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.module:code"		VALUE = "mmlsk-discount_product">
	<MvASSIGN NAME = "l.module:name"		VALUE = "Product Discount">
	<MvASSIGN NAME = "l.module:provider"	VALUE = "Miva Merchant">
	<MvASSIGN NAME = "l.module:version"		VALUE = "26.0300">
	<MvASSIGN NAME = "l.module:api_ver"		VALUE = "26.03">
	<MvASSIGN NAME = "l.module:features"	VALUE = "discount">
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Capabilities" PARAMETERS = "module var, capabilities var" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.capabilities:items"					VALUE = 1>
	<MvASSIGN NAME = "l.capabilities:basket"				VALUE = 0>
	<MvASSIGN NAME = "l.capabilities:shipping"				VALUE = 0>
	<MvASSIGN NAME = "l.capabilities:tax"					VALUE = 0>
	<MvASSIGN NAME = "l.capabilities:provision_settings"	VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Property_Template" PARAMETERS = "module var" STANDARDOUTPUTLEVEL = "text, html, compresswhitespace">
	<mm-grid columns="4" column-sizes="repeat( 4, 1fr )">
		<mm-grid-row>
			<mm-grid-column grid-column="span 2">
				<mm-flex-item prompt="Discount">
					<mm-grid columns="3" column-sizes="repeat(3, 1fr)">
						<mm-grid-column grid-column="span 2">
							<mm-module-field-ui code="type" size="full" noprompt></mm-module-field-ui>
						</mm-grid-column>

						<mm-grid-column hide-with-fields="type_percent">
							<mm-module-field-ui code="type_percent" size="full" noprompt></mm-module-field-ui>
						</mm-grid-column>

						<mm-grid-column hide-with-fields="type_fixed">						
							<mm-module-field-ui code="type_fixed" size="full" noprompt></mm-module-field-ui>
						</mm-grid-column>
					</mm-grid>
				</mm-flex-item>
			</mm-grid-column>

			<mm-grid-column grid-column="span 2">
				<mm-module-field-ui code="selection" size="full"></mm-module-field-ui>
			</mm-grid-column>
		</mm-grid-row>

		<mm-grid-row>
			<mm-grid-column grid-column="span 2">
				<mm-flex-item prompt="Maximum Discount Quantity">
					<mm-flex-group>
						<mm-module-field-ui code="maxquantitytype" size="full" noprompt></mm-module-field-ui>
						<mm-module-field-ui code="maxquantity" size="full" noprompt></mm-module-field-ui>
					</mm-flex-group>
				</mm-flex-item>
			</mm-grid-column>

			<mm-grid-column grid-column="span 2">
				<mm-flex-item prompt="Maximum Cumulative Discount">
					<mm-flex-group>
						<mm-module-field-ui code="maxdiscounttype" size="full" noprompt></mm-module-field-ui>
						<mm-module-field-ui code="maxdiscount" size="full" noprompt></mm-module-field-ui>
					</mm-flex-group>
				</mm-flex-item>
			</mm-grid-column>
		</mm-grid-row>
	</mm-grid>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Properties" PARAMETERS = "module var" STANDARDOUTPUTLEVEL = "text, html, compresswhitespace">
	{
		"type":
		{
			"type": "selector",
			"prompt": "Discount Type",
			"required": true,
			"options":
			[
				{
					"text": "Fixed",
					"value": "fixed"
				},
				{
					"text": "Percent",
					"value": "percent"
				}
			]
		},
		"type_percent":
		{
			"type": "text",
			"prompt": "Discount",
			"required": true,
			"text_type": "number",
			"min": 0,
			"pad_right_digits": 2,
			"visibility_conditions":
			{
				"type":
				{
					"value": [ "percent" ]
				}
			}
		},
		"type_fixed":
		{
			"type": "text",
			"prompt": "Discount",
			"required": true,
			"text_type": "number",
			"min": 0,
			"pad_right_digits": 2,
			"max_right_digits": 8,
			"visibility_conditions":
			{
				"type":
				{
					"value": [ "fixed" ]
				}
			}
		},
		"selection":
		{
			"type": "select",
			"prompt": "Discount Applies To",
			"required": true,
			"options":
			[
				{
					"text": "Lowest Priced Line Item",
					"value": "lowest"
				},
				{
					"text": "Highest Priced Line Item",
					"value": "highest"
				}
			]
		},
		"maxquantitytype":
		{
			"type": "select",
			"prompt": "Maximum Discount Quantity Type",
			"required": true,
			"options":
			[
				{
					"text": "Set Amount",
					"value": "custom"
				},
				{
					"text": "No Restrictions",
					"value": "none"
				}
			]
		},
		"maxquantity":
		{
			"type": "text",
			"prompt": "Maximum Discount Quantity",
			"required": true,
			"text_type": "number",
			"min": 0,
			"wholenumber": true,
			"visibility_conditions":
			{
				"maxquantitytype":
				{
					"value": [ "custom" ]
				}
			}
		},
		"maxdiscounttype":
		{
			"type": "select",
			"prompt": "Maximum Cumulative Discount Type",
			"required": true,
			"options":
			[
				{
					"text": "Set Amount",
					"value": "custom"
				},
				{
					"text": "No Restrictions",
					"value": "none"
				}
			]
		},
		"maxdiscount":
		{
			"type": "text",
			"prompt": "Maximum Cumulative Discount",
			"required": true,
			"text_type": "number",
			"min": 0,
			"pad_right_digits": 2,
			"max_right_digits": 8,
			"visibility_conditions":
			{
				"maxdiscounttype":
				{
					"value": [ "custom" ]
				}
			}
		}
	}
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Settings_Default" PARAMETERS = "module var, settings var" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.settings"							VALUE = "">
	<MvASSIGN NAME = "l.settings:type:value"				VALUE = "percent">
	<MvASSIGN NAME = "l.settings:type_percent:value"		VALUE = 0.00>
	<MvASSIGN NAME = "l.settings:type_fixed:value"			VALUE = 0.00>
	<MvASSIGN NAME = "l.settings:selection:value"			VALUE = "lowest">
	<MvASSIGN NAME = "l.settings:maxquantitytype:value"		VALUE = "none">
	<MvASSIGN NAME = "l.settings:maxquantity:value"			VALUE = 0>
	<MvASSIGN NAME = "l.settings:maxdiscounttype:value"		VALUE = "none">
	<MvASSIGN NAME = "l.settings:maxdiscount:value"			VALUE = 0.00>

	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Settings_Load" PARAMETERS = "module var, pricegroup var, settings var" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.settings"								VALUE = "">
	<MvASSIGN NAME = "l.settings:type:value"					VALUE = "{ l.pricegroup:config:type }">
	<MvASSIGN NAME = "l.settings:selection:value"				VALUE = "{ l.pricegroup:config:selection }">

	<MvIF EXPR = "{ l.pricegroup:config:type EQ 'percent' }">
		<MvASSIGN NAME = "l.settings:type_percent:value"		VALUE = "{ [ g.Module_Library_Utilities ].Price_Pad( l.pricegroup:config:discount ) }">
		<MvASSIGN NAME = "l.settings:type_fixed:value"			VALUE = 0.00>
	<MvELSE>
		<MvASSIGN NAME = "l.settings:type_fixed:value"			VALUE = "{ [ g.Module_Library_Utilities ].Price_Pad( l.pricegroup:config:discount ) }">
		<MvASSIGN NAME = "l.settings:type_percent:value"		VALUE = 0.00>
	</MvIF>

	<MvIF EXPR = "{ l.pricegroup:config:maxquantity EQ 0 }">
		<MvASSIGN NAME = "l.settings:maxquantity:value"			VALUE = 0>
		<MvASSIGN NAME = "l.settings:maxquantitytype:value"		VALUE = "none">
	<MvELSE>
		<MvASSIGN NAME = "l.settings:maxquantity:value"			VALUE = "{ l.pricegroup:config:maxquantity }">
		<MvASSIGN NAME = "l.settings:maxquantitytype:value"		VALUE = "custom">
	</MvIF>

	<MvIF EXPR = "{ l.pricegroup:config:maxdiscount EQ 0 }">
		<MvASSIGN NAME = "l.settings:maxdiscount:value"			VALUE = 0.00>
		<MvASSIGN NAME = "l.settings:maxdiscounttype:value"		VALUE = "none">
	<MvELSE>
		<MvASSIGN NAME = "l.settings:maxdiscount:value"			VALUE = "{ [ g.Module_Library_Utilities ].Price_Pad( l.pricegroup:config:maxdiscount ) }">
		<MvASSIGN NAME = "l.settings:maxdiscounttype:value"		VALUE = "custom">
	</MvIF>

	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Settings_Validate" PARAMETERS = "module var, pricegroup var, settings var" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Settings_Update" PARAMETERS = "module var, pricegroup var, settings var" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.pricegroup:config:type"			VALUE = "{ l.settings:type:value }">
	<MvASSIGN NAME = "l.pricegroup:config:selection"	VALUE = "{ l.settings:selection:value }">

	<MvIF EXPR = "{ l.settings:type EQ 'percent' }">					<MvASSIGN NAME = "l.pricegroup:config:discount"		VALUE = "{ l.settings:type_percent:value ROUND 2 }">
	<MvELSE>															<MvASSIGN NAME = "l.pricegroup:config:discount"		VALUE = "{ l.settings:type_fixed:value ROUND 8 }">
	</MvIF>

	<MvIF EXPR = "{ l.settings:maxquantitytype:value EQ 'custom' }"> 	<MvASSIGN NAME = "l.pricegroup:config:maxquantity" 	VALUE = "{ l.settings:maxquantity:value }">
	<MvELSE>															<MvASSIGN NAME = "l.pricegroup:config:maxquantity" 	VALUE = 0>
	</MvIF>

	<MvIF EXPR = "{ l.settings:maxdiscounttype:value EQ 'custom' }"> 	<MvASSIGN NAME = "l.pricegroup:config:maxdiscount" 	VALUE = "{ l.settings:maxdiscount:value ROUND 8 }">
	<MvELSE>															<MvASSIGN NAME = "l.pricegroup:config:maxdiscount" 	VALUE = 0.00>
	</MvIF>

	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Discount_Items" PARAMETERS = "module var, pricegroup var, discount_state var" STANDARDOUTPUTLEVEL = "">
	<MvIF EXPR = "{ ( l.pricegroup:config:type NE 'fixed' ) AND
					( l.pricegroup:config:type NE 'percent' ) }">
		<MvFUNCTIONRETURN VALUE = 1>
	</MvIF>

	<MvIF EXPR = "{ l.pricegroup:config:selection EQ 'highest' }">		<MvASSIGN NAME = "l.item_count" VALUE = "{ [ g.Module_Feature_PGR_UT ].DiscountState_Eligible_Items_Sorted_TotalPriceDescending( l.discount_state, l.items ) }">
	<MvELSE>															<MvASSIGN NAME = "l.item_count" VALUE = "{ [ g.Module_Feature_PGR_UT ].DiscountState_Eligible_Items_Sorted_TotalPriceAscending( l.discount_state, l.items ) }">
	</MvIF>

	<MvASSIGN NAME = "l.discount_remaining"					VALUE = "{ l.pricegroup:config:maxdiscount }">
	<MvASSIGN NAME = "l.discount_quantity"					VALUE = "{ l.pricegroup:config:maxquantity }">

	<MvFOREACH ITERATOR = "l.item" ARRAY = "l.items" COUNT = "{ l.item_count }">
		<MvIF EXPR = "{ ( l.pricegroup:config:maxquantity EQ 0 ) OR
						( l.item:quantity LT l.discount_quantity ) }">	<MvASSIGN NAME = "l.item_discount_quantity"	VALUE = "{ l.item:quantity }">
		<MvELSE>														<MvASSIGN NAME = "l.item_discount_quantity" VALUE = "{ l.discount_quantity }">
		</MvIF>

		<MvIF EXPR = "{ l.pricegroup:config:maxdiscount EQ 0 }">
			<MvIF EXPR = "{ l.pricegroup:config:type EQ 'fixed' }">			<MvEVAL EXPR = "{ [ g.Module_Feature_PGR_UT ].DiscountState_Discount_Item_Fixed( l.discount_state, l.item, l.item_discount_quantity, l.pricegroup:config:discount ) }">
			<MvELSEIF EXPR = "{ l.pricegroup:config:type EQ 'percent' }">	<MvEVAL EXPR = "{ [ g.Module_Feature_PGR_UT ].DiscountState_Discount_Item_Percent( l.discount_state, l.item, l.item_discount_quantity, l.pricegroup:config:discount ) }">
			</MvIF>
		<MvELSE>
			<MvIF EXPR = "{ NOT [ g.Module_Library_Utilities ].Price_IsHighPrecision( l.item:eligible_price ) }">	<MvASSIGN NAME = "l.scale" VALUE = 2>
			<MvELSE>																								<MvASSIGN NAME = "l.scale" VALUE = 8>
			</MvIF>

			<MvIF EXPR = "{ l.pricegroup:config:type EQ 'fixed' }">
				<MvIF EXPR = "{ l.item:eligible_price GT l.pricegroup:config:discount }">	<MvASSIGN NAME = "l.item_discount"	VALUE = "{ l.pricegroup:config:discount }">
				<MvELSE>																	<MvASSIGN NAME = "l.item_discount"	VALUE = "{ l.item:eligible_price }">
				</MvIF>
			<MvELSEIF EXPR = "{ l.pricegroup:config:type EQ 'percent' }">
				<MvASSIGN NAME = "l.item_discount"			VALUE = "{ ( l.item:eligible_price * ( l.pricegroup:config:discount / 100 ) ) ROUND l.scale }">
			</MvIF>

			<MvFOR COUNT = "{ l.item_discount_quantity }">
				<MvIF EXPR = "{ l.item_discount GT l.discount_remaining }">
					<MvIF EXPR = "{ l.scale EQ 2 }">	<MvASSIGN NAME = "l.item_discount" VALUE = "{ floor( l.discount_remaining * 100 ) / 100 }">
					<MvELSE>							<MvASSIGN NAME = "l.item_discount" VALUE = "{ l.discount_remaining }">
					</MvIF>
				</MvIF>

				<MvEVAL EXPR = "{ [ g.Module_Feature_PGR_UT ].DiscountState_Discount_Item_Fixed( l.discount_state, l.item, 1, l.item_discount ) }">

				<MvASSIGN NAME = "l.discount_remaining"		VALUE = "{ l.discount_remaining - l.item_discount }">
				<MvIF EXPR = "{ l.discount_remaining EQ 0 }">
					<MvFOREACHSTOP>
				</MvIF>
			</MvFOR>
		</MvIF>

		<MvIF EXPR = "{ l.pricegroup:config:maxquantity }">
			<MvASSIGN NAME = "l.discount_quantity"			VALUE = "{ l.discount_quantity - l.item_discount_quantity }">
			<MvIF EXPR = "{ l.discount_quantity EQ 0 }">
				<MvFOREACHSTOP>
			</MvIF>
		</MvIF>
	</MvFOREACH>

	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Provision_Settings" PARAMETERS = "module var, pricegroup var, provide_xml var" STANDARDOUTPUTLEVEL = "">
	<MvIF EXPR = "{ l.pricegroup:module_id NE l.module:id }">
		<MvASSIGN NAME = "l.pricegroup:config:discount"		VALUE = 0.00>
		<MvASSIGN NAME = "l.pricegroup:config:type"			VALUE = "percent">
		<MvASSIGN NAME = "l.pricegroup:config:selection"	VALUE = "lowest">
		<MvASSIGN NAME = "l.pricegroup:config:maxquantity"	VALUE = 0>
		<MvASSIGN NAME = "l.pricegroup:config:maxdiscount"	VALUE = 0.00>
	</MvIF>

	<MvIF EXPR = "{ NOT [ g.Module_Feature_PRV_AD ].PRV_Tag_List(		'o',		l.provide_xml, 'Type',			l.pricegroup:config:type,		'Fixed,Percent',	'fixed,percent' )	OR
					NOT [ g.Module_Feature_PRV_AD ].PRV_Tag_List(		'o',		l.provide_xml, 'Selection',		l.pricegroup:config:selection,	'Lowest,Highest',	'lowest,highest' )	OR
					NOT [ g.Module_Feature_PRV_AD ].PRV_Tag_Integer(	'o:nonneg',	l.provide_xml, 'MaxQuantity',	l.pricegroup:config:maxquantity )										OR
					NOT [ g.Module_Feature_PRV_AD ].PRV_Tag_Price(		'o:nonneg', l.provide_xml, 'MaxDiscount',	l.pricegroup:config:maxdiscount ) }">
		<MvFUNCTIONRETURN VALUE = 0>
	</MvIF>

	<MvIF EXPR = "{ l.pricegroup:config:type EQ 'percent' }">
		<MvIF EXPR = "{ NOT [ g.Module_Feature_PRV_AD ].PRV_Tag_Number( 'o:nonneg', l.provide_xml, 'Discount', l.pricegroup:config:discount, 10, 2 ) }">
			<MvFUNCTIONRETURN VALUE = 0>
		</MvIF>
	<MvELSE>
		<MvIF EXPR = "{ NOT [ g.Module_Feature_PRV_AD ].PRV_Tag_Price( 'o:nonneg', l.provide_xml, 'Discount', l.pricegroup:config:discount ) }">
			<MvFUNCTIONRETURN VALUE = 0>
		</MvIF>
	</MvIF>

	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_PriceGroup_Delete" PARAMETERS = "module var, pricegroup var" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_PriceGroup_Copy" PARAMETERS = "module var, source_pricegroup var, dest_pricegroup var" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>
