<MvFUNCTION NAME = "Module_Description" PARAMETERS = "module var" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.module:code"		VALUE = "mmlsk-discount_shipping_basket">
	<MvASSIGN NAME = "l.module:name"		VALUE = "Shipping Discount (Entire Order)">
	<MvASSIGN NAME = "l.module:provider"	VALUE = "Miva Merchant">
	<MvASSIGN NAME = "l.module:version"		VALUE = "26.0300">
	<MvASSIGN NAME = "l.module:api_ver"		VALUE = "26.03">
	<MvASSIGN NAME = "l.module:features"	VALUE = "discount">
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Capabilities" PARAMETERS = "module var, capabilities var" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.capabilities:items"					VALUE = 0>
	<MvASSIGN NAME = "l.capabilities:basket"				VALUE = 0>
	<MvASSIGN NAME = "l.capabilities:shipping"				VALUE = 1>
	<MvASSIGN NAME = "l.capabilities:tax"					VALUE = 0>
	<MvASSIGN NAME = "l.capabilities:provision_settings"	VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Property_Template" PARAMETERS = "module var" STANDARDOUTPUTLEVEL = "text, html, compresswhitespace">
	<mm-flex-container max-width="unset">
		<mm-grid columns="2" column-sizes="repeat( 2, 1fr )">
			<mm-grid-row>
				<mm-grid-column grid-column="span 2">
					<mm-flex-item prompt="Method Selection">
						<mm-flex-group>
							<mm-module-field-ui code="list_adjust" size="full"></mm-module-field-ui>
						</mm-flex-group>
					</mm-flex-item>
				</mm-grid-column>
			</mm-grid-row>

			<mm-grid-row>
				<mm-grid-column>
					<mm-module-field-ui code="list_descrip" size="full"></mm-module-field-ui>
				</mm-grid-column>
			</mm-grid-row>

			<mm-grid-row hide-with-fields="list_append">
				<mm-grid-column>
					<mm-module-field-ui code="list_append" size="full"></mm-module-field-ui>
				</mm-grid-column>
			</mm-grid-row>

			<mm-grid-row hide-with-fields="list_replace">
				<mm-grid-column>
					<mm-module-field-ui code="list_replace" size="full"></mm-module-field-ui>
				</mm-grid-column>
			</mm-grid-row>
		</mm-grid>

		<mm-divider></mm-divider>

		<mm-grid columns="2" column-sizes="repeat( 2, 1fr )">
			<mm-grid-row>
				<mm-grid-column grid-column="span 2">
					<mm-module-field-ui code="charge" size="full"></mm-module-field-ui>
				</mm-grid-column>
			</mm-grid-row>

			<mm-grid-row hide-with-fields="charge_modify_descrip">
				<mm-grid-column>
					<mm-module-field-ui code="charge_modify_descrip" size="full"></mm-module-field-ui>
				</mm-grid-column>
			</mm-grid-row>

			<mm-grid-row hide-with-fields="charge_modify_append">
				<mm-grid-column>
					<mm-module-field-ui code="charge_modify_append" size="full"></mm-module-field-ui>
				</mm-grid-column>
			</mm-grid-row>

			<mm-grid-row hide-with-fields="charge_modify_replace">
				<mm-grid-column>
					<mm-module-field-ui code="charge_modify_replace" size="full"></mm-module-field-ui>
				</mm-grid-column>
			</mm-grid-row>

			<mm-grid-row hide-with-fields="charge_add_descrip">
				<mm-grid-column>
					<mm-module-field-ui code="charge_add_descrip" size="full"></mm-module-field-ui>
				</mm-grid-column>
			</mm-grid-row>

			<mm-grid-row>
				<mm-grid-column grid-column="span 2">
					<mm-module-field-ui code="methods" size="full"></mm-module-field-ui>
				</mm-grid-column>
			</mm-grid-row>

			<mm-grid-row>
				<mm-grid-column>
					<mm-module-field-ui code="states" size="full"></mm-module-field-ui>
				</mm-grid-column>

				<mm-grid-column>
					<mm-module-field-ui code="countries" size="full"></mm-module-field-ui>
				</mm-grid-column>
			</mm-grid-row>

			<mm-grid-row>
				<mm-grid-column grid-column="span 2">
					<mm-module-field-ui code="zips" size="full"></mm-module-field-ui>
				</mm-grid-column>
			</mm-grid-row>
		</mm-grid>
	</mm-flex-container>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Properties" PARAMETERS = "module var" STANDARDOUTPUTLEVEL = "text, html, compresswhitespace">
	{
		"list_adjust":
		{
			"type": "checkbox",
			"prompt": "Reflect Discount in Shipping Method List"
		},
		"list_descrip":
		{
			"type": "selector",
			"prompt": "Shipping Method Name",
			"required": true,
			"options":
			[
				{
					"text": "Keep As Is",
					"value": "none"
				},
				{
					"text": "Append",
					"value": "append"
				},
				{
					"text": "Replace",
					"value": "replace"
				}
			]
		},
		"list_append":
		{
			"type": "text",
			"prompt": "Append Text to Method Name",
			"required": true,
			"visibility_conditions":
			{
				"list_descrip":
				{
					"value": [ "append" ]
				}
			}
		},
		"list_replace":
		{
			"type": "text",
			"prompt": "Replace Method Name With",
			"required": true,
			"visibility_conditions":
			{
				"list_descrip":
				{
					"value": [ "replace" ]
				}
			}
		},
		"charge":
		{
			"type": "select",
			"prompt": "Display in Basket",
			"required": true,
			"options":
			[
				{
					"text": "Modify Applied Charge to Reflect Discount",
					"value": "modify"
				},
				{
					"text": "Add a Charge Showing the Discount Amount",
					"value": "add"
				}
			]
		},
		"charge_modify_descrip":
		{
			"type": "selector",
			"prompt": "Basket Description",
			"required": true,
			"options":
			[
				{
					"text": "Keep As Is",
					"value": "none"
				},
				{
					"text": "Append",
					"value": "append"
				},
				{
					"text": "Replace",
					"value": "replace"
				}
			],
			"visibility_conditions":
			{
				"charge":
				{
					"value": [ "modify" ]
				}
			}
		},
		"charge_modify_append":
		{
			"type": "text",
			"prompt": "Append to Description",
			"required": true,
			"visibility_conditions":
			{
				"charge":
				{
					"value": [ "modify" ]
				},
				"charge_modify_descrip":
				{
					"value": [ "append" ]
				}
			}
		},
		"charge_modify_replace":
		{
			"type": "text",
			"prompt": "Replace Description With",
			"required": true,
			"visibility_conditions":
			{
				"charge":
				{
					"value": [ "modify" ]
				},
				"charge_modify_descrip":
				{
					"value": [ "replace" ]
				}
			}
		},
		"charge_add_descrip":
		{
			"type": "text",
			"prompt": "Discount Charge Description",
			"required": true,
			"visibility_conditions":
			{
				"charge":
				{
					"value": [ "add" ]
				}
			}
		},
		"methods":
		{
			"type": "loadedcolumnlist",
			"prompt": "Method Discounts",
			"function": "ShippingMethodList_Load_Enabled",
			"empty_message": "No shipping methods are configured",
			"record_identifiers":
			[
				{
					"code": "module_code",
					"mapping": "record:module:code"
				},
				{
					"code": "method_code",
					"mapping": "record:code"
				}
			],
			"columns":
			[
				{
					"header": "Discount",
					"size": "auto",
					"properties":
					[
						{
							"code": "discount_type",
							"type": "selector",
							"prompt": "Discount Type",
							"size": "auto",
							"options":
							[
								{
									"text": "Fixed",
									"value": "fixed"
								},
								{
									"text": "Percent",
									"value": "percent"
								}
							]
						}
					]
				},
				{
					"header": "",
					"size": "120px",
					"properties":
					[
						{
							"code": "discount",
							"type": "text",
							"prompt": "Discount Amount",
							"text_type": "number",
							"min": 0,
							"placeholder": "0.00",
							"pad_right_digits": 2
						}
					]
				},
				{
					"header": "Method",
					"size": "1fr",
					"properties":
					[
						{
							"code": "name",
							"type": "loadedcolumnlistdisplaytext",
							"prompt": "Method",
							"mapping": "record:name",
							"encoding": "shipping",
							"wrap": true
						}
					]
				}
			]
		},
		"states":
		{
			"type": "statemultiselect",
			"prompt": "Restrict to These States"
		},
		"countries":
		{
			"type": "countrymultiselect",
			"prompt": "Restrict to These Countries"
		},
		"zips":
		{
			"type": "text",
			"prompt": "Restrict to Zip Codes (comma separated)"
		}
	}
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Settings_Default" PARAMETERS = "module var, settings var" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.settings"								VALUE = "">
	<MvASSIGN NAME = "l.settings:list_adjust:value"				VALUE = 1>
	<MvASSIGN NAME = "l.settings:list_descrip:value"			VALUE = "none">
	<MvASSIGN NAME = "l.settings:list_append:value"				VALUE = "">
	<MvASSIGN NAME = "l.settings:list_replace:value"			VALUE = "">
	<MvASSIGN NAME = "l.settings:charge:value"					VALUE = "modify">
	<MvASSIGN NAME = "l.settings:charge_modify_descrip:value"	VALUE = "none">
	<MvASSIGN NAME = "l.settings:charge_modify_append:value"	VALUE = "(discounted)">
	<MvASSIGN NAME = "l.settings:charge_modify_replace:value"	VALUE = "Discounted Shipping">
	<MvASSIGN NAME = "l.settings:charge_add_descrip:value"		VALUE = "Shipping Discount">
	<MvASSIGN NAME = "l.settings:methods:values"				VALUE = "">
	<MvASSIGN NAME = "l.settings:states:values"					VALUE = "">
	<MvASSIGN NAME = "l.settings:countries:values"				VALUE = "">
	<MvASSIGN NAME = "l.settings:zips:value"					VALUE = "">

	<MvASSIGN NAME = "l.method_count" VALUE = "{ [ g.Module_Feature_SHP_UT ].ShippingMethodList_Load_Enabled( l.methods ) }">

	<MvFOREACH ITERATOR = "l.method" ARRAY = "l.methods" COUNT = "{ l.method_count }">
		<MvASSIGN NAME = "l.method_value:module_code"			VALUE = "{ l.method:module:code }">
		<MvASSIGN NAME = "l.method_value:method_code"			VALUE = "{ l.method:code }">
		<MvASSIGN NAME = "l.method_value:discount:value"		VALUE = 0.00>
		<MvASSIGN NAME = "l.method_value:discount_type:value"	VALUE = "fixed">

		<MvASSIGN NAME = "l.null" VALUE = "{ miva_array_insert_var( l.settings:methods:values, l.method_value, -1 ) }">
	</MvFOREACH>

	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Settings_Load" PARAMETERS = "module var, pricegroup var, settings var" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.settings"										VALUE = "">
	<MvASSIGN NAME = "l.settings:states:values"							VALUE = "">
	<MvASSIGN NAME = "l.settings:countries:values"						VALUE = "">
	<MvASSIGN NAME = "l.settings:methods:values"						VALUE = "">
	<MvASSIGN NAME = "l.settings:zips:value"							VALUE = "{ l.pricegroup:config:zips }">
	<MvASSIGN NAME = "l.settings:list_adjust:value"						VALUE = "{ l.pricegroup:config:list_adjust }">
	<MvASSIGN NAME = "l.settings:list_descrip:value"					VALUE = "{ l.pricegroup:config:list_descrip }">

	<MvIF EXPR = "{ l.pricegroup:config:list_descrip EQ 'append' }">
		<MvASSIGN NAME = "l.settings:list_append:value"					VALUE = "{ l.pricegroup:config:list_append }">
	<MvELSE>
		<MvASSIGN NAME = "l.settings:list_append:value"					VALUE = "">
	</MvIF>

	<MvIF EXPR = "{ l.pricegroup:config:list_descrip EQ 'replace' }">
		<MvASSIGN NAME = "l.settings:list_replace:value"				VALUE = "{ l.pricegroup:config:list_replace }">
	<MvELSE>
		<MvASSIGN NAME = "l.settings:list_replace:value"				VALUE = "">
	</MvIF>

	<MvASSIGN NAME = "l.settings:charge:value"							VALUE = "{ l.pricegroup:config:charge }">
	<MvASSIGN NAME = "l.settings:charge_modify_descrip:value"			VALUE = "{ l.pricegroup:config:charge_modify_descrip }">

	<MvIF EXPR = "{ l.pricegroup:config:charge_modify_descrip EQ 'append' }">
		<MvASSIGN NAME = "l.settings:charge_modify_append:value"		VALUE = "{ l.pricegroup:config:charge_modify_append }">
	<MvELSE>
		<MvASSIGN NAME = "l.settings:charge_modify_append:value"		VALUE = "(discounted)">
	</MvIF>

	<MvIF EXPR = "{ l.pricegroup:config:charge_modify_descrip EQ 'replace' }">
		<MvASSIGN NAME = "l.settings:charge_modify_replace:value"		VALUE = "{ l.pricegroup:config:charge_modify_replace }">
	<MvELSE>
		<MvASSIGN NAME = "l.settings:charge_modify_replace:value"		VALUE = "Discounted Shipping">
	</MvIF>

	<MvIF EXPR = "{ l.pricegroup:config:charge EQ 'add' }">
		<MvASSIGN NAME = "l.settings:charge_add_descrip:value"			VALUE = "{ l.pricegroup:config:charge_add_descrip }">
	<MvELSE>
		<MvASSIGN NAME = "l.settings:charge_add_descrip:value"			VALUE = "Shipping Discount">
	</MvIF>

	<MvFOREACH ITERATOR = "l.state_code" ARRAY = "l.state_codes" COUNT = "{ miva_struct_members( l.pricegroup:config:states, l.state_codes ) }">
		<MvASSIGN NAME = "l.state_value:value"							VALUE = "{ l.state_code }">

		<MvASSIGN NAME = "l.null" VALUE = "{ miva_array_insert_var( l.settings:states:values, l.state_value, -1 ) }">
	</MvFOREACH>

	<MvFOREACH ITERATOR = "l.country_code" ARRAY = "l.country_codes" COUNT = "{ miva_struct_members( l.pricegroup:config:countries, l.country_codes ) }">
		<MvASSIGN NAME = "l.country_value:value"						VALUE = "{ l.country_code }">

		<MvASSIGN NAME = "l.null" VALUE = "{ miva_array_insert_var( l.settings:countries:values, l.country_value, -1 ) }">
	</MvFOREACH>

	<MvFOREACH ITERATOR = "l.module_code" ARRAY = "l.module_codes" COUNT = "{ miva_struct_members( l.pricegroup:config:methods, l.module_codes ) }">
		<MvREFERENCEARRAY NAME = "l.module_methods" VARIABLE = "l.pricegroup">
			<MvMEMBER NAME = "config">
			<MvMEMBER NAME = "methods">
			<MvMEMBER NAME = "{ l.module_code }">
		</MvREFERENCEARRAY>

		<MvFOREACH ITERATOR = "l.method_code" ARRAY = "l.method_codes" COUNT = "{ miva_struct_members( l.module_methods, l.method_codes ) }">
			<MvREFERENCEARRAY NAME = "l.method_settings" VARIABLE = "l.module_methods">
				<MvMEMBER NAME = "{ l.method_code }">
			</MvREFERENCEARRAY>

			<MvASSIGN NAME = "l.method_value:module_code"				VALUE = "{ l.module_code }">
			<MvASSIGN NAME = "l.method_value:method_code"				VALUE = "{ l.method_code }">
			<MvASSIGN NAME = "l.method_value:discount:value"			VALUE = "{ l.method_settings:discount ROUND 2 }">
			<MvASSIGN NAME = "l.method_value:discount_type:value"		VALUE = "{ ternary( ISNULL l.method_settings:discount_type, 'fixed', l.method_settings:discount_type ) }">

			<MvASSIGN NAME = "l.null" VALUE = "{ miva_array_insert_var( l.settings:methods:values, l.method_value, -1 ) }">
		</MvFOREACH>
	</MvFOREACH>

	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Settings_Validate" PARAMETERS = "module var, pricegroup var, settings var" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Settings_Update" PARAMETERS = "module var, pricegroup var, settings var" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.pricegroup:config:list_adjust"						VALUE = "{ l.settings:list_adjust:value }">
	<MvASSIGN NAME = "l.pricegroup:config:list_descrip"						VALUE = "{ l.settings:list_descrip:value }">

	<MvIF EXPR = "{ l.settings:list_descrip:value EQ 'append' }">
		<MvASSIGN NAME = "l.pricegroup:config:list_append"					VALUE = "{ l.settings:list_append:value }">
	<MvELSEIF EXPR = "{ l.settings:list_descrip:value EQ 'replace' }">
		<MvASSIGN NAME = "l.pricegroup:config:list_replace"					VALUE = "{ l.settings:list_replace:value }">
	</MvIF>

	<MvASSIGN NAME = "l.pricegroup:config:charge"							VALUE = "{ l.settings:charge:value }">

	<MvIF EXPR = "{ l.settings:charge:value EQ 'modify' }">
		<MvASSIGN NAME = "l.pricegroup:config:charge_modify_descrip"		VALUE = "{ l.settings:charge_modify_descrip:value }">

		<MvIF EXPR = "{ l.settings:charge_modify_descrip:value EQ 'append' }">
			<MvASSIGN NAME = "l.pricegroup:config:charge_modify_append"		VALUE = "{ l.settings:charge_modify_append:value }">
		<MvELSEIF EXPR = "{ l.settings:charge_modify_descrip:value EQ 'replace' }">
			<MvASSIGN NAME = "l.pricegroup:config:charge_modify_replace"	VALUE = "{ l.settings:charge_modify_replace:value }">
		</MvIF>
	<MvELSEIF EXPR = "{ l.settings:charge:value EQ 'add' }">
		<MvASSIGN NAME = "l.pricegroup:config:charge_add_descrip"			VALUE = "{ l.settings:charge_add_descrip:value }">
	</MvIF>

	<MvASSIGN NAME = "l.pricegroup:config:zips"								VALUE = "{ l.settings:zips:value }">
	<MvASSIGN NAME = "l.pricegroup:config:states"							VALUE = "">
	<MvASSIGN NAME = "l.pricegroup:config:countries"						VALUE = "">

	<MvFOREACH ITERATOR = "l.state_value" ARRAY = "l.settings:states:values">
		<MvASSIGN NAME = "l.pricegroup:config:states" MEMBER = "{ l.state_value:value }" VALUE = 1>
	</MvFOREACH>

	<MvFOREACH ITERATOR = "l.country_value" ARRAY = "l.settings:countries:values">
		<MvASSIGN NAME = "l.pricegroup:config:countries" MEMBER = "{ l.country_value:value }" VALUE = 1>
	</MvFOREACH>

	<MvASSIGN NAME = "l.pricegroup:config:methods"							VALUE = "">

	<MvFOREACH ITERATOR = "l.method_value" ARRAY = "l.settings:methods:values">
		<MvIF EXPR = "{ l.method_value:discount:value }">
			<MvASSIGNARRAY NAME = "l.pricegroup" VALUE = "{ l.method_value:discount:value }">
				<MvMEMBER NAME = "config">
				<MvMEMBER NAME = "methods">
				<MvMEMBER NAME = "{ l.method_value:module_code }">
				<MvMEMBER NAME = "{ l.method_value:method_code }">
				<MvMEMBER NAME = "discount">
			</MvASSIGNARRAY>

			<MvASSIGNARRAY NAME = "l.pricegroup" VALUE = "{ l.method_value:discount_type:value }">
				<MvMEMBER NAME = "config">
				<MvMEMBER NAME = "methods">
				<MvMEMBER NAME = "{ l.method_value:module_code }">
				<MvMEMBER NAME = "{ l.method_value:method_code }">
				<MvMEMBER NAME = "discount_type">
			</MvASSIGNARRAY>
		</MvIF>
	</MvFOREACH>

	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Discount_ShippingMethodList" PARAMETERS = "module var, pricegroup var, discount_state var, methods var, method_count" STANDARDOUTPUTLEVEL = "">
	<MvIF EXPR = "{ Shipping_Basket_ConfigurationExcludes( l.pricegroup, l.discount_state ) }">
		<MvFUNCTIONRETURN VALUE = 1>
	</MvIF>

	<MvFOREACH ITERATOR = "l.method" ARRAY = "l.methods" COUNT = "{ l.method_count }">
		<MvREFERENCEARRAY NAME = "l.method_settings" VARIABLE = "l.pricegroup">
			<MvMEMBER NAME = "config">
			<MvMEMBER NAME = "methods">
			<MvMEMBER NAME = "{ l.method:module:code }">
			<MvMEMBER NAME = "{ l.method:code }">
		</MvREFERENCEARRAY>

		<MvIF EXPR = "{ ( l.method_settings:discount LE 0 ) OR ( l.method:price LE 0 ) }">
			<MvFOREACHCONTINUE>
		</MvIF>

		<MvIF EXPR = "{ l.pricegroup:config:list_adjust }">						<MvASSIGN NAME = "l.method:price"	VALUE = "{ ( l.method:price - ShippingBasket_Calculate_Discount( l.method_settings, l.method:price ) ) ROUND 2 }">
		</MvIF>

		<MvIF EXPR = "{ l.pricegroup:config:list_descrip EQ 'append' }">		<MvASSIGN NAME = "l.method:name"	VALUE = "{ l.method:name $ ' ' $ trim( l.pricegroup:config:list_append ) }">
		<MvELSEIF EXPR = "{ l.pricegroup:config:list_descrip EQ 'replace' }">	<MvASSIGN NAME = "l.method:name"	VALUE = "{ l.pricegroup:config:list_replace }">
		</MvIF>
	</MvFOREACH>

	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Discount_Shipping" PARAMETERS = "module var, pricegroup var, discount_state var, shipping_module var, shipping_method_code" STANDARDOUTPUTLEVEL = "">
	<MvIF EXPR = "{ Shipping_Basket_ConfigurationExcludes( l.pricegroup, l.discount_state ) }">
		<MvFUNCTIONRETURN VALUE = 1>
	</MvIF>

	<MvREFERENCEARRAY NAME = "l.method_settings" VARIABLE = "l.pricegroup">
		<MvMEMBER NAME = "config">
		<MvMEMBER NAME = "methods">
		<MvMEMBER NAME = "{ l.shipping_module:code }">
		<MvMEMBER NAME = "{ l.shipping_method_code }">
	</MvREFERENCEARRAY>

	<MvIF EXPR = "{ l.method_settings:discount LE 0 }">
		<MvFUNCTIONRETURN VALUE = 1>
	</MvIF>

	<MvASSIGN NAME = "l.charge_count"					VALUE = "{ [ g.Module_Feature_PGR_UT ].DiscountState_Charges( l.discount_state, 'SHIPPING', l.charges ) }">
	<MvIF EXPR = "{ l.charge_count EQ 0 }">
		<MvFUNCTIONRETURN VALUE = 1>
	</MvIF>

	<MvASSIGN NAME = "l.shipping_total"					VALUE = 0.00>
	<MvASSIGN NAME = "l.shipping_disp_total"			VALUE = 0.00>

	<MvFOREACH ITERATOR = "l.charge" ARRAY = "l.charges" COUNT = "{ l.charge_count }">
		<MvASSIGN NAME = "l.shipping_total"				VALUE = "{ l.shipping_total + l.charge:amount }">
		<MvASSIGN NAME = "l.shipping_disp_total"		VALUE = "{ l.shipping_disp_total + l.charge:disp_amt }">
	</MvFOREACH>

	<MvIF EXPR = "{ l.shipping_total LE 0 }">
		<MvFUNCTIONRETURN VALUE = 1>
	</MvIF>

	<MvIF EXPR = "{ l.pricegroup:config:charge EQ 'add' }">
		<MvASSIGN NAME = "l.append_charge:module_id"	VALUE = "{ l.module:id }">
		<MvASSIGN NAME = "l.append_charge:type"			VALUE = "SHIPPING">
		<MvASSIGN NAME = "l.append_charge:descrip"		VALUE = "{ l.pricegroup:config:charge_add_descrip }">
		<MvASSIGN NAME = "l.append_charge:tax_exempt"	VALUE = "{ l.charges[ 1 ]:tax_exempt }">
		<MvASSIGN NAME = "l.append_charge:amount"		VALUE = "{ ( 0 - ShippingBasket_Calculate_Discount( l.method_settings, l.shipping_total ) ) ROUND 2 }">
		<MvASSIGN NAME = "l.append_charge:disp_amt"		VALUE = "{ ( 0 - ShippingBasket_Calculate_Discount( l.method_settings, l.shipping_disp_total ) ) ROUND 2 }">

		<MvEVAL EXPR = "{ [ g.Module_Feature_PGR_UT ].DiscountState_Discount_Charge_Add( l.discount_state, l.append_charge ) }">
	<MvELSEIF EXPR = "{ l.pricegroup:config:charge EQ 'modify' }">
		<MvIF EXPR = "{ l.method_settings:discount_type EQ 'percent' }">
			<MvFOREACH ITERATOR = "l.charge" ARRAY = "l.charges" COUNT = "{ l.charge_count }">
				<MvASSIGN NAME = "l.discount"			VALUE = "{ ShippingBasket_Calculate_Discount( l.method_settings, l.charge:amount ) }">
				<MvASSIGN NAME = "l.disp_discount"		VALUE = "{ ShippingBasket_Calculate_Discount( l.method_settings, l.charge:disp_amt ) }">

				<MvIF EXPR = "{ l.pricegroup:config:charge_modify_descrip EQ 'append' }">
					<MvASSIGN NAME = "l.charge:descrip"	VALUE = "{ l.charge:descrip $ ' ' $ trim( l.pricegroup:config:charge_modify_append ) }">
				<MvELSEIF EXPR = "{ l.pricegroup:config:charge_modify_descrip EQ 'replace' }">
					<MvASSIGN NAME = "l.charge:descrip"	VALUE = "{ l.pricegroup:config:charge_modify_replace }">
				</MvIF>

				<MvEVAL EXPR = "{ [ g.Module_Feature_PGR_UT ].DiscountState_Discount_Charge_Fixed( l.discount_state, l.charge, l.discount, l.disp_discount ) }">
			</MvFOREACH>
		<MvELSEIF EXPR = "{ l.method_settings:discount_type EQ 'fixed' }">
			<MvASSIGN NAME = "l.discount"				VALUE = "{ ShippingBasket_Calculate_Discount( l.method_settings, l.shipping_total ) }">
			<MvASSIGN NAME = "l.disp_discount"			VALUE = "{ ShippingBasket_Calculate_Discount( l.method_settings, l.shipping_disp_total ) }">

			<MvIF EXPR = "{ l.discount OR l.disp_discount }">
				<MvREFERENCEARRAY NAME = "l.charge" VARIABLE = "l.charges">
					<MvDIMENSION INDEX = 1>
				</MvREFERENCEARRAY>

				<MvIF EXPR = "{ l.pricegroup:config:charge_modify_descrip EQ 'append' }">
					<MvASSIGN NAME = "l.charge:descrip"	VALUE = "{ l.charge:descrip $ ' ' $ trim( l.pricegroup:config:charge_modify_append ) }">
				<MvELSEIF EXPR = "{ l.pricegroup:config:charge_modify_descrip EQ 'replace' }">
					<MvASSIGN NAME = "l.charge:descrip"	VALUE = "{ l.pricegroup:config:charge_modify_replace }">
				</MvIF>

				<MvEVAL EXPR = "{ [ g.Module_Feature_PGR_UT ].DiscountState_Discount_Charge_Fixed( l.discount_state, l.charge, l.discount, l.disp_discount ) }">
			</MvIF>
		</MvIF>
	</MvIF>

	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Provision_Settings" PARAMETERS = "module var, pricegroup var, provide_xml var" STANDARDOUTPUTLEVEL = "">
	<MvIF EXPR = "{ l.pricegroup:module_id NE l.module:id }">
		<MvASSIGN NAME = "l.pricegroup:config:list_adjust"				VALUE = 1>
		<MvASSIGN NAME = "l.pricegroup:config:list_descrip"				VALUE = "none">
		<MvASSIGN NAME = "l.pricegroup:config:list_append"				VALUE = "">
		<MvASSIGN NAME = "l.pricegroup:config:list_replace"				VALUE = "">
		
		<MvASSIGN NAME = "l.pricegroup:config:charge"					VALUE = "modify">
		<MvASSIGN NAME = "l.pricegroup:config:charge_modify_descrip"	VALUE = "none">
		<MvASSIGN NAME = "l.pricegroup:config:charge_modify_append"		VALUE = "(discounted)">
		<MvASSIGN NAME = "l.pricegroup:config:charge_modify_replace"	VALUE = "Discounted Shipping">
		<MvASSIGN NAME = "l.pricegroup:config:charge_add_descrip"		VALUE = "Shipping Discount">

		<MvASSIGN NAME = "l.pricegroup:config:states"					VALUE = "">
		<MvASSIGN NAME = "l.pricegroup:config:countries"				VALUE = "">
		<MvASSIGN NAME = "l.pricegroup:config:zips"						VALUE = "">

		<MvASSIGN NAME = "l.pricegroup:config:methods"					VALUE = "">
	</MvIF>

	<MvIF EXPR = "{ NOT [ g.Module_Feature_PRV_AD ].PRV_Tag_Boolean( 'o', l.provide_xml, 'ShowDiscountInMethodList', l.pricegroup:config:list_adjust ) }">
		<MvFUNCTIONRETURN VALUE = 0>
	</MvIF>

	<MvIF EXPR = "{ [ g.Module_Feature_PRV_AD ].PRV_Tag_Exists( l.provide_xml, 'MethodListName' ) }">
		<MvIF EXPR = "{ NOT [ g.Module_Feature_PRV_AD ].PRV_Attribute_List( l.provide_xml:tags:MethodListName[ 1 ], 'modification', l.pricegroup:config:list_descrip, 'none,append,replace', 'none,append,replace' ) }">
			<MvFUNCTIONRETURN VALUE = 0>
		</MvIF>

		<MvIF EXPR = "{ l.pricegroup:config:list_descrip EQ 'append' }">
			<MvIF EXPR = "{ NOT [ g.Module_Feature_PRV_AD ].PRV_Tag_Text( 'R', l.provide_xml, 'MethodListName', l.pricegroup:config:list_append ) }">
				<MvFUNCTIONRETURN VALUE = 0>
			</MvIF>
		<MvELSEIF EXPR = "{ l.pricegroup:config:list_descrip EQ 'replace' }">
			<MvIF EXPR = "{ NOT [ g.Module_Feature_PRV_AD ].PRV_Tag_Text( 'R', l.provide_xml, 'MethodListName', l.pricegroup:config:list_replace ) }">
				<MvFUNCTIONRETURN VALUE = 0>
			</MvIF>
		</MvIF>
	</MvIF>

	<MvIF EXPR = "{ [ g.Module_Feature_PRV_AD ].PRV_Tag_Exists( l.provide_xml, 'DisplayInBasket' ) }">
		<MvIF EXPR = "{ NOT [ g.Module_Feature_PRV_AD ].PRV_Attribute_List( l.provide_xml:tags:DisplayInBasket[ 1 ], 'method', l.pricegroup:config:charge, 'modify,add', 'modify,add' ) }">
			<MvFUNCTIONRETURN VALUE = 0>
		</MvIF>

		<MvIF EXPR = "{ l.pricegroup:config:charge EQ 'add' }">
			<MvIF EXPR = "{ NOT [ g.Module_Feature_PRV_AD ].PRV_Tag_Text( 'R', l.provide_xml, 'DisplayInBasket', l.pricegroup:config:charge_add_descrip ) }">
				<MvFUNCTIONRETURN VALUE = 0>
			</MvIF>
		<MvELSEIF EXPR = "{ l.pricegroup:config:charge EQ 'modify' }">
			<MvIF EXPR = "{ NOT [ g.Module_Feature_PRV_AD ].PRV_Attribute_List( l.provide_xml:tags:DisplayInBasket[ 1 ], 'modification', l.pricegroup:config:charge_modify_descrip, 'none,append,replace', 'none,append,replace' ) }">
				<MvFUNCTIONRETURN VALUE = 0>
			</MvIF>

			<MvIF EXPR = "{ l.pricegroup:config:charge_modify_descrip EQ 'append' }">
				<MvIF EXPR = "{ NOT [ g.Module_Feature_PRV_AD ].PRV_Tag_Text( 'R', l.provide_xml, 'DisplayInBasket', l.pricegroup:config:charge_modify_append ) }">
					<MvFUNCTIONRETURN VALUE = 0>
				</MvIF>
			<MvELSEIF EXPR = "{ l.pricegroup:config:charge_modify_descrip EQ 'replace' }">
				<MvIF EXPR = "{ NOT [ g.Module_Feature_PRV_AD ].PRV_Tag_Text( 'R', l.provide_xml, 'DisplayInBasket', l.pricegroup:config:charge_modify_replace ) }">
					<MvFUNCTIONRETURN VALUE = 0>
				</MvIF>
			</MvIF>
		</MvIF>
	</MvIF>

	<MvIF EXPR = "{ [ g.Module_Feature_PRV_AD ].PRV_Tag_Exists( l.provide_xml, 'MethodDiscounts' ) }">
		<MvFOREACH ITERATOR = "l.child_xml" ARRAY = "l.provide_xml:tags:MethodDiscounts[ 1 ]:children">
			<MvASSIGN NAME = "l.name"		VALUE = "{ tolower( l.child_xml:name ) }">

			<MvIF EXPR = "{ l.name EQ 'methoddiscount' }">
				<MvIF EXPR = "{ NOT [ g.Module_Feature_PRV_AD ].PRV_Attribute_Text( l.child_xml, 'module_code',	l.module_code ) OR
								NOT [ g.Module_Feature_PRV_AD ].PRV_Attribute_Text( l.child_xml, 'method_code',	l.method_code ) }">
					<MvFUNCTIONRETURN VALUE = 0>
				</MvIF>

				<MvREFERENCEARRAY NAME = "l.method" VARIABLE = "l.pricegroup">
					<MvMEMBER NAME = "config">
					<MvMEMBER NAME = "methods">
					<MvMEMBER NAME = "{ l.module_code }">
					<MvMEMBER NAME = "{ l.method_code }">
				</MvREFERENCEARRAY>

				<MvIF EXPR = "{ NOT [ g.Module_Feature_PRV_AD ].PRV_Attribute_List(		l.child_xml, 'type',			l.method:discount_type,	'fixed,percent', 'fixed,percent' )	OR
								NOT [ g.Module_Feature_PRV_AD ].PRV_Attribute_Number(	l.child_xml, 'discount',		l.method:discount,		10, 2 ) }">
					<MvFUNCTIONRETURN VALUE = 0>
				</MvIF>
			<MvELSE>
				<MvFUNCTIONRETURN VALUE = "{ [ g.Module_Feature_PRV_AD ].PRV_LogMessage( l.child_xml, 'Unknown tag' ) }">
			</MvIF>
		</MvFOREACH>
	</MvIF>

	<MvIF EXPR = "{ [ g.Module_Feature_PRV_AD ].PRV_Tag_Exists( l.provide_xml, 'Restrictions' ) }">
		<MvIF EXPR = "{ NOT DiscountModule_Provision_Settings_GeographicRestrictions( l.provide_xml:tags:Restrictions[ 1 ], l.pricegroup ) }">
			<MvFUNCTIONRETURN>
		</MvIF>
	</MvIF>

	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Provision_Settings_GeographicRestrictions" PARAMETERS = "provide_xml var, pricegroup var" STANDARDOUTPUTLEVEL = "">
	<MvIF EXPR = "{ NOT [ g.Module_Feature_PRV_AD ].PRV_Tag_Text( 'o', l.provide_xml, 'ZipCodes', l.pricegroup:config:zips ) }">
		<MvFUNCTIONRETURN VALUE = 0>
	</MvIF>

	<MvIF EXPR = "{ [ g.Module_Feature_PRV_AD ].PRV_Tag_Exists( l.provide_xml, 'States' ) }">
		<MvEVAL EXPR = "{ DiscountModule_Provision_Settings_GeographicRestrictions_States( l.provide_xml:tags:States[ 1 ], l.pricegroup:config:states ) }">
	</MvIF>

	<MvIF EXPR = "{ [ g.Module_Feature_PRV_AD ].PRV_Tag_Exists( l.provide_xml, 'Countries' ) }">
		<MvEVAL EXPR = "{ DiscountModule_Provision_Settings_GeographicRestrictions_Countries( l.provide_xml:tags:Countries[ 1 ], l.pricegroup:config:countries ) }">
	</MvIF>

	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Provision_Settings_GeographicRestrictions_States" PARAMETERS = "provide_xml var, states var" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.states"										VALUE = "">

	<MvFOREACH ITERATOR = "l.child_xml" ARRAY = "l.provide_xml:children">
		<MvASSIGN NAME = "l.name"									VALUE = "{ tolower( l.child_xml:name ) }">

		<MvIF EXPR = "{ l.name EQ 'state' }">
			<MvIF EXPR = "{ [ g.Module_Feature_PRV_AD ].PRV_Attribute_Text( l.child_xml, 'code', l.state ) }">
				<MvASSIGN NAME = "l.states" MEMBER = "{ l.state }"	VALUE = 1>
			</MvIF>
		<MvELSE>
			<MvEVAL EXPR = "{ [ g.Module_Feature_PRV_AD ].PRV_LogMessage( l.child_xml, 'Unknown tag' ) }">
		</MvIF>
	</MvFOREACH>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_Provision_Settings_GeographicRestrictions_Countries" PARAMETERS = "provide_xml var, countries var" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.countries"										VALUE = "">

	<MvFOREACH ITERATOR = "l.child_xml" ARRAY = "l.provide_xml:children">
		<MvASSIGN NAME = "l.name"										VALUE = "{ tolower( l.child_xml:name ) }">

		<MvIF EXPR = "{ l.name EQ 'country' }">
			<MvIF EXPR = "{ [ g.Module_Feature_PRV_AD ].PRV_Attribute_Text( l.child_xml, 'code', l.country ) }">
				<MvASSIGN NAME = "l.countries" MEMBER = "{ l.country }"	VALUE = 1>
			</MvIF>
		<MvELSE>
			<MvEVAL EXPR = "{ [ g.Module_Feature_PRV_AD ].PRV_LogMessage( l.child_xml, 'Unknown tag' ) }">
		</MvIF>
	</MvFOREACH>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_PriceGroup_Copy" PARAMETERS = "module var, pricegroup var, pricegroup_copy var" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "DiscountModule_PriceGroup_Delete" PARAMETERS = "module var, pricegroup var" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "ShippingBasket_Calculate_Discount" PARAMETERS = "method_settings var, method_price" STANDARDOUTPUTLEVEL = "">
	<MvIF EXPR = "{ l.method_settings:discount_type EQ 'percent' }">
		<MvFUNCTIONRETURN VALUE = "{ ( l.method_price * ( l.method_settings:discount / 100 ) ) ROUND 2 }">
	<MvELSEIF EXPR = "{ l.method_settings:discount_type EQ 'fixed' }">
		<MvIF EXPR = "{ l.method_settings:discount GT l.method_price }">	<MvFUNCTIONRETURN VALUE = "{ l.method_price ROUND 2 }">
		<MvELSE>															<MvFUNCTIONRETURN VALUE = "{ l.method_settings:discount ROUND 2 }">
		</MvIF>
	</MvIF>

	<MvFUNCTIONRETURN VALUE = 0.00>
</MvFUNCTION>

<MvCOMMENT>
|
| Helper Functions
|
</MvCOMMENT>

<MvFUNCTION NAME = "Shipping_Basket_ConfigurationExcludes" PARAMETERS = "pricegroup var, discount_state var" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.custinfo" VALUE = "{ [ g.Module_Feature_PGR_UT ].DiscountState_CustomerInformation( l.discount_state ) }">

	<MvIF EXPR = "{ NOT ISNULL l.pricegroup:config:zips }">
		<MvIF EXPR = "{ NOT [ g.Module_Library_Utilities ].ZipInList( l.pricegroup:config:zips, l.custinfo:ship_zip ) }">
			<MvFUNCTIONRETURN VALUE = 1>
		</MvIF>
	</MvIF>

	<MvIF EXPR = "{ NOT ISNULL l.pricegroup:config:states }">
		<MvIF EXPR = "{ NOT miva_member_exists( l.pricegroup:config:states, l.custinfo:ship_state ) }">
			<MvFUNCTIONRETURN VALUE = 1>
		</MvIF>
	</MvIF>

	<MvIF EXPR = "{ NOT ISNULL l.pricegroup:config:countries }">
		<MvIF EXPR = "{ NOT miva_member_exists( l.pricegroup:config:countries, l.custinfo:ship_cntry ) }">
			<MvFUNCTIONRETURN VALUE = 1>
		</MvIF>
	</MvIF>

	<MvFUNCTIONRETURN VALUE = 0>
</MvFUNCTION>
